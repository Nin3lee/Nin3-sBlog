---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { slide } from "astro:transitions";

const DEFAULT_DESCRIPTION =
    "Nin3 的个人博客，分享 UI 设计、视觉创作、AIGC 工具实践与前端开发中的思考和经验。";

const { pageTitle, description = DEFAULT_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
    <head>
        <!-- General meta tag -->
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, user-scalable=1"
        />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content={description || DEFAULT_DESCRIPTION}
        />
        <!-- Google AdSense -->
        <meta
            name="google-adsense-account"
            content="ca-pub-1026637122289333"
        />
        <script
            defer
            src="https://cloud.umami.is/script.js"
            data-website-id="13315dc1-aabc-4a42-b7d1-1f4e3d2cd7bc"></script>
        <ClientRouter />
        <title>{pageTitle}</title>
    </head>
    <body class="min-h-screen flex flex-col">
        <Nav />
        <div transition:animate={slide({ duration: "0.4s" })}>
            <slot />
        </div>
        <Footer />
    </body>
</html>
