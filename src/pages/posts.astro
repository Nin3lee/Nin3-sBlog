---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { formatDate } from "../utils/date";

const pageTitle = "Post";

let PostByTime = await getCollection("posts");
PostByTime = PostByTime.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
    pageTitle={`Nin3's ${pageTitle}`}
    description="浏览 Nin3 发布的全部文章，涵盖 UI 设计、视觉创作、AIGC 实践、设计经验与个人记录。"
>
    <div class="w-90 md:w-[45rem] mx-auto flex flex-col my-9">
        <p class="text-section-title mb-3">{pageTitle}</p>
        <ul>
            {
                PostByTime.map((post) => (
                    <li class="flex">
                        <a
                            href={`/posts/${post.id}/`}
                            class="mb-6 hover:scale-95 duration-200"
                        >
                            <h1 class="text-gray-700 text-post-title font-bold">
                                {post.data.title}
                            </h1>
                            <div class="text-gray-400">
                                {formatDate(post.data.pubDate)} · {post.data.tags}
                            </div>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</BaseLayout>
